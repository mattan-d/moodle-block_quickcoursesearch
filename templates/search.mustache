{{!
    @template block_quickcoursesearch/search

    Search field for the quick course search block.

    Context variables required for this template:
    * instanceid - Block instance id.
    * actionurl - Page URL used when JavaScript is unavailable.
    * query - Current query.
    * minlength - Minimum query length.
    * searchlabel - Accessible name of the field.
    * placeholder - Field placeholder.
    * search - Search button label.

    Example context (json):
    {
        "instanceid": 1,
        "actionurl": "https://example.com/my/",
        "query": "",
        "minlength": 2,
        "searchlabel": "Search courses",
        "placeholder": "Course name, short name, ID or ID number",
        "search": "Search"
    }
}}
<div class="quickcoursesearch"
     data-region="quickcoursesearch"
     data-instanceid="{{instanceid}}"
     data-minlength="{{minlength}}">
    <form method="get" action="{{actionurl}}" class="quickcoursesearch-form">
        <input type="hidden" name="qcsi" value="{{instanceid}}">
        <label class="sr-only" for="quickcoursesearch-q-{{instanceid}}">{{searchlabel}}</label>
        <div class="input-group">
            <input type="search"
                   id="quickcoursesearch-q-{{instanceid}}"
                   name="qcsq"
                   value="{{query}}"
                   class="form-control"
                   placeholder="{{placeholder}}"
                   autocomplete="off"
                   enterkeyhint="search"
                   data-region="search-input">
            <div class="input-group-append">
                <button type="submit" class="btn btn-primary">{{search}}</button>
            </div>
        </div>
    </form>
    <div data-region="search-results" aria-live="polite">
        {{#searched}}
            {{> block_quickcoursesearch/results }}
        {{/searched}}
    </div>
</div>
{{#js}}
require(['block_quickcoursesearch/search'], function(Search) {
    Search.init('[data-region="quickcoursesearch"][data-instanceid="{{instanceid}}"]');
});
{{/js}}
