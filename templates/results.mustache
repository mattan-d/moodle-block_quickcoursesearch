{{!
    @template block_quickcoursesearch/results

    Course search results.

    Context variables required for this template:
    * courses - Matching courses.
    * hascourses - Whether courses is not empty.
    * message - Empty-state or validation message.
    * more - Whether the list was truncated.
    * moremessage - Text explaining the truncation.

    Example context (json):
    {
        "hascourses": true,
        "message": "",
        "more": false,
        "moremessage": "",
        "hiddenlabel": "Hidden",
        "categorylabel": "Category",
        "shortnamelabel": "Short name",
        "courses": [{
            "id": 2,
            "fullname": "Biology",
            "shortname": "BIO",
            "category": "Science",
            "viewurl": "https://example.com/course/view.php?id=2",
            "hidden": false
        }]
    }
}}
{{#message}}
    <p class="quickcoursesearch-message text-muted mb-0">{{message}}</p>
{{/message}}
{{#hascourses}}
    <ul class="list-unstyled quickcoursesearch-results mb-2">
        {{#courses}}
            <li class="quickcoursesearch-result">
                <a class="quickcoursesearch-link" href="{{viewurl}}">
                    <span class="quickcoursesearch-name">
                        {{fullname}}
                        {{#hidden}}
                            <span class="badge badge-secondary">{{hiddenlabel}}</span>
                        {{/hidden}}
                    </span>
                    <span class="quickcoursesearch-meta">
                        <span class="sr-only">{{categorylabel}} </span>{{category}}
                    </span>
                    <span class="quickcoursesearch-meta">
                        <span class="sr-only">{{shortnamelabel}} </span>{{shortname}}
                    </span>
                </a>
            </li>
        {{/courses}}
    </ul>
{{/hascourses}}
{{#more}}
    <p class="quickcoursesearch-more text-muted small mb-0">{{moremessage}}</p>
{{/more}}
